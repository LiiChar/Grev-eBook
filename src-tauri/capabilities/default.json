{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
			"core:default",
			"opener:default",
			"dialog:default",
			"store:default",
			"log:default",
			"core:window:default",
			"core:window:allow-close",
			"core:window:allow-start-dragging",
			"fs:default",
			{
				"identifier": "fs:allow-read-dir",
				"allow": [
					{
						"path": "**"
					}
				]
			},
			{
				"identifier": "fs:allow-read-file",
				"allow": [
					{
						"path": "**"
					}
				]
			}
		]
}